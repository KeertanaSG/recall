# Copy to .env and fill in. Never put real values in this file.

# Required
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
# Comma-separated Telegram user IDs. Everyone else is ignored.
ALLOWED_USER_IDS=

# Optional
# RECALL_DATA_DIR=data
# RECALL_DEFAULT_TIMEZONE=Asia/Kolkata
# RECALL_MODEL=claude-haiku-5-5
# Used only when a new table is created.
# RECALL_DESIGN_MODEL=claude-opus-5-5
# RECALL_EFFORT=low
# Model for search planning and relevance grading.
# RECALL_RETRIEVAL_MODEL=claude-haiku-5-5
# Roughly a third faster at twice the Opus price. Has no effect on Haiku.
# RECALL_FAST_MODE=false
# Search locally before the first model call, so simple questions take one step.
# RECALL_PREFETCH=true
# RECALL_MAX_REMINDERS_PER_DAY=5
# RECALL_MAX_MESSAGES_PER_USER_PER_DAY=30
# RECALL_MAX_MESSAGES_PER_DAY=300

# API and MCP. Both listen on localhost, so put HTTPS in front before exposing them.
# RECALL_API_PORT=8787
# RECALL_MCP_PORT=8788
# RECALL_MCP_PUBLIC_URL=http://127.0.0.1:8788
# RECALL_API_REQUESTS_PER_MINUTE=60
