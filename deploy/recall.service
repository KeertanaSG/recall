[Unit]
Description=Recall Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
User=recall
WorkingDirectory=/opt/recall
ExecStart=/usr/local/bin/uv run --no-dev recall
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/recall

[Install]
WantedBy=multi-user.target
